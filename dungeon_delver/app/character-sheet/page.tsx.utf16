'use client';
import { useState, useEffect } from 'react';
import { getLiveStats, SKILL_MAP } from '../../utils/characterEngine';
import { DataEngine } from '../../utils/dataLoader';
import { save, open } from '@tauri-apps/plugin-dialog';
import { writeTextFile, readTextFile } from '@tauri-apps/plugin-fs';
import { getLevelFromXP, getNextLevelXP } from '../../utils/levelingEngine';
import { Character, ClassLevel } from '../../lib/character';
import CharacterWizard from '../../components/CharacterWizard';

export default function CharacterSheet() {
    const [isWizardOpen, setIsWizardOpen] = useState(false);
    const [wizardMode, setWizardMode] = useState<'create' | 'levelup'>('create');

    const handleWizardComplete = (finalDraft: Character) => {
        console.log("New Character Data:", finalDraft); // Debug: Check your console!
        setChar(finalDraft); // Overwrites everything
        setIsWizardOpen(false);
    };
    // --- STATE ---
    const [char, setChar] = useState<Character>({
        name: 'Adventurer',
        race: 'Human',
        class: 'Fighter',
        classLevels: [{ className: 'Fighter', level: 1 }],
        totalLevel: 1,
        hp: { current: 10, max: 10 },
        xp: 0,
        level: 1,
        levelingMode: 'individual',
        baseStats: { str: 15, dex: 14, con: 13, int: 10, wis: 12, cha: 8 },
        inventory: [],
        proficiencies: ['athletics', 'perception']
    });

    const [xpToAdd, setXpToAdd] = useState(0);
    const [viewingItem, setViewingItem] = useState<any | null>(null);
    const [isSearching, setIsSearching] = useState(false);
    const [allLibraryItems, setAllLibraryItems] = useState<any[]>([]);
    const [itemSearch, setItemSearch] = useState('');
    const [rollResult, setRollResult] = useState<string | null>(null);

    const live = getLiveStats(char);

    // --- LOGIC ---
    const handleAddXp = () => {
        const newXp = char.xp + xpToAdd;
        const newLevel = char.levelingMode !== 'milestone' ? getLevelFromXP(newXp) : char.level;
        setChar({ ...char, xp: newXp, level: newLevel });
        setXpToAdd(0);
    };

    const handleManualLevel = (newLevel: number) => {
        setChar({ ...char, level: Math.max(1, Math.min(20, newLevel)) });
    };

    const saveChar = async () => {
        try {
            const path = await save({
                filters: [{ name: 'JSON', extensions: ['json'] }],
                defaultPath: `${char.name}.json`
            });
            if (path) {
                await writeTextFile(path, JSON.stringify(char, null, 2));
                alert("Character Saved!");
            }
        } catch (err) { console.error(err); }
    };

    const loadChar = async () => {
        try {
            const selected = await open({ multiple: false, filters: [{ name: 'JSON', extensions: ['json'] }] });
            if (selected && !Array.isArray(selected)) {
                const content = await readTextFile(selected);
                setChar(JSON.parse(content));
            }
        } catch (err) { console.error(err); }
    };

    const toggleItem = (id: string) => {
        setChar({
            ...char,
            inventory: char.inventory.map((item: any) =>
                item.id === id ? { ...item, equipped: !item.equipped } : item
            )
        });
    };

    const rollCheck = (statName: string, mod: number) => {
        const roll = Math.floor(Math.random() * 20) + 1;
        setRollResult(`${statName.toUpperCase()} Check: ${roll} + ${mod} = ${roll + mod}`);
    };

    const addItemFromLibrary = (libItem: any) => {
        let bonus = 0;
        if (libItem.ac) {
            bonus = typeof libItem.ac === 'number' ? libItem.ac : (libItem.ac.ac || 0);
        }
        const newItem = {
            id: `${libItem.name}-${Date.now()}`,
            name: libItem.name,
            equipped: false,
            modifiers: { ac: bonus },
            entries: libItem.entries
        };
        setChar(prev => ({ ...prev, inventory: [...prev.inventory, newItem] }));
        setIsSearching(false);
    };

    const openSearch = async () => {
        const items = await DataEngine.getItems();
        setAllLibraryItems(items);
        setIsSearching(true);
    };

    const formatEntries = (entries: any): React.ReactNode => {
        if (!entries) return null;
        if (typeof entries === 'string') return <p>{entries}</p>;
        if (Array.isArray(entries)) return entries.map((e, i) => <div key={i}>{formatEntries(e)}</div>);
        if (typeof entries === 'object' && entries.items) {
            return <ul>{entries.items.map((it: any, i: number) => <li key={i}>{formatEntries(it)}</li>)}</ul>;
        }
        return null;
    };

    // --- SHARED STYLES ---
    const inputStyle = {
        background: '#2d3748',
        border: '1px solid #4a5568',
        color: 'white',
        padding: '5px',
        borderRadius: '4px',
        outline: 'none',
        fontSize: '1rem'
    };

    return (
        <>
            {char.classLevels && char.classLevels.length > 0 && (
                <div
                    key={char.classLevels[0].className} // Force React to "re-draw" when class changes
                    style={{
                        position: 'fixed',
                        top: 0,
                        left: 0,
                        width: '100vw',
                        height: '100vh',
                        opacity: 0.3,
                        // We use a template literal and force the first letter to be uppercase 
                        // and the rest lowercase to match standard filename conventions
                        backgroundImage: `url(/img/classes/${char.classLevels[0].className.charAt(0).toUpperCase() + char.classLevels[0].className.slice(1).toLowerCase()}.png)`,
                        backgroundSize: 'contain',
                        backgroundPosition: 'center',
                        backgroundRepeat: 'no-repeat',
                        pointerEvents: 'none',
                        zIndex: 0,
                    }}
                />
            )}
            <div style={{ padding: '20px', background: '#1a202c', color: 'white', minHeight: '100vh', fontFamily: 'serif' }}>

                {/* 1. HEADER (Level Tracker & Info) */}
                <header style={{ display: 'flex', justifyContent: 'space-between', borderBottom: '2px solid #b8860b', paddingBottom: '15px', marginBottom: '20px' }}>
                    <div style={{ display: 'flex', gap: '20px', alignItems: 'center' }}>
                        <div style={{ textAlign: 'center', background: '#b8860b', padding: '10px', borderRadius: '8px', minWidth: '60px' }}>
                            <div style={{ fontSize: '0.7rem', color: 'black', fontWeight: 'bold' }}>LEVEL</div>
                            <div style={{ fontSize: '1.8rem', fontWeight: 'bold', color: 'white' }}>{char.level}</div>
                        </div>
                        <div>
                            <input
                                value={char.name}
                                onChange={(e) => setChar({ ...char, name: e.target.value })}
                                style={{ ...inputStyle, fontSize: '1.8rem', fontWeight: 'bold', border: 'none', background: 'transparent', padding: 0 }}
                            />
                            <div style={{ display: 'flex', gap: '10px', marginTop: '5px' }}>
                                <input style={{ ...inputStyle, fontSize: '0.9rem', width: '100px' }} value={char.race} onChange={e => setChar({ ...char, race: e.target.value })} placeholder="Race" />
                                <input style={{ ...inputStyle, fontSize: '0.9rem', width: '100px' }} value={char.class} onChange={e => setChar({ ...char, class: e.target.value })} placeholder="Class" />
                            </div>
                        </div>
                    </div>

                    <div style={{ textAlign: 'right' }}>
                        <div style={{ fontSize: '0.8rem', color: '#a0aec0' }}>ARMOR CLASS</div>
                        <div style={{ fontSize: '2rem', color: '#f6e05e', fontWeight: 'bold' }}>{live.ac}</div>
                        <div style={{ display: 'flex', gap: '10px', marginTop: '10px' }}><button
                            onClick={() => {
                                setWizardMode('levelup');
                                setIsWizardOpen(true);
                            }}
                        >
                            Level Up
                        </button>

                            {/* NEW CHARACTER BUTTON (In the header) */}
                            <button
                                onClick={() => {
                                    setWizardMode('create');
                                    setIsWizardOpen(true);
                                }}
                            >
                                New Character
                            </button>
                            <button onClick={loadChar} style={{ background: 'transparent', color: '#a0aec0', border: '1px solid #4a5568', padding: '5px 10px', cursor: 'pointer' }}>Load</button>
                            <button onClick={saveChar} style={{ background: '#4a5568', color: 'white', border: 'none', padding: '5px 15px', borderRadius: '4px', cursor: 'pointer' }}>Save</button>
                        </div>
                    </div>
                </header>

                {/* ROLL RESULT */}
                {rollResult && (
                    <div style={{ background: '#6366f1', padding: '12px', marginBottom: '20px', borderRadius: '8px', textAlign: 'center', fontWeight: 'bold', display: 'flex', justifyContent: 'center', alignItems: 'center' }}>
                        <span>{rollResult}</span>
                        <button onClick={() => setRollResult(null)} style={{ marginLeft: '15px', background: 'rgba(0,0,0,0.2)', border: 'none', color: 'white', borderRadius: '50%', width: '25px', height: '25px', cursor: 'pointer' }}>├ù</button>
                    </div>
                )}

                {/* MAIN 3-COLUMN CONTENT */}
                <div style={{ display: 'grid', gridTemplateColumns: '120px 240px 1fr', gap: '20px' }}>

                    {/* COLUMN 1: ABILITY SCORES */}
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
                        {Object.entries(live.stats).map(([stat, score]) => (
                            <div key={stat} onClick={() => rollCheck(stat, live.modifiers[stat])} style={{ background: '#2d3748', padding: '10px', borderRadius: '8px', textAlign: 'center', cursor: 'pointer', border: '1px solid #4a5568' }}>
                                <div style={{ fontSize: '0.65rem', color: '#a0aec0', fontWeight: 'bold' }}>{stat.toUpperCase()}</div>
                                <div style={{ fontSize: '1.3rem', fontWeight: 'bold' }}>{score as number}</div>
                                <div style={{ color: '#f6e05e', fontWeight: 'bold' }}>{live.modifiers[stat] >= 0 ? '+' : ''}{live.modifiers[stat]}</div>
                            </div>
                        ))}
                    </div>

                    {/* COLUMN 2: SKILLS */}
                    <div style={{ background: '#2d3748', padding: '15px', borderRadius: '8px', border: '1px solid #4a5568' }}>
                        <h4 style={{ margin: '0 0 10px 0', borderBottom: '1px solid #4a5568', color: '#a0aec0' }}>SKILLS</h4>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: '5px' }}>
                            {Object.entries(SKILL_MAP).map(([skill, stat]) => {
                                const isProf = char.proficiencies.includes(skill);
                                const bonus = live.skills[skill];
                                return (
                                    <div key={skill} onClick={() => rollCheck(skill, bonus)} style={{ display: 'flex', justifyContent: 'space-between', fontSize: '0.8rem', padding: '3px 6px', cursor: 'pointer', borderRadius: '4px', background: isProf ? 'rgba(99, 102, 241, 0.15)' : 'transparent' }}>
                                        <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                                            <div style={{ width: '6px', height: '6px', borderRadius: '50%', border: '1px solid #6366f1', background: isProf ? '#6366f1' : 'transparent' }}></div>
                                            <span style={{ color: isProf ? '#fff' : '#cbd5e0' }}>{skill.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase())}</span>
                                        </div>
                                        <span style={{ fontWeight: 'bold', color: isProf ? '#f6e05e' : '#718096' }}>{bonus >= 0 ? '+' : ''}{bonus}</span>
                                    </div>
                                );
                            })}
                        </div>
                    </div>

                    {/* COLUMN 3: CONTENT (HP, XP, INVENTORY) */}
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>

                        {/* HP & PROFICIENCY */}
                        <div style={{ display: 'flex', gap: '20px' }}>
                            <div style={{ flex: 1, background: '#2d3748', padding: '15px', borderRadius: '8px', textAlign: 'center' }}>
                                <div style={{ fontSize: '0.7rem', color: '#a0aec0' }}>HIT POINTS</div>
                                <div style={{ fontSize: '1.4rem' }}>{char.hp.current} / {char.hp.max}</div>
                            </div>
                            <div style={{ flex: 1, background: '#2d3748', padding: '15px', borderRadius: '8px', textAlign: 'center' }}>
                                <div style={{ fontSize: '0.7rem', color: '#a0aec0' }}>PROFICIENCY</div>
                                <div style={{ fontSize: '1.4rem' }}>+{live.profBonus}</div>
                            </div>
                        </div>

                        {/* XP & LEVELING */}
                        <div style={{ background: '#2d3748', padding: '15px', borderRadius: '8px' }}>
                            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '10px' }}>
                                <h4 style={{ margin: 0 }}>PROGRESSION</h4>
                                <div style={{ display: 'flex', gap: '5px' }}>
                                    {['milestone', 'individual'].map(m => (
                                        <button key={m} onClick={() => setChar({ ...char, levelingMode: m as any })} style={{ fontSize: '0.6rem', padding: '2px 6px', background: char.levelingMode === m ? '#6366f1' : '#4a5568', color: 'white', border: 'none', borderRadius: '3px' }}>{m.toUpperCase()}</button>
                                    ))}
                                </div>
                            </div>

                            {char.levelingMode === 'milestone' ? (
                                <div style={{ display: 'flex', alignItems: 'center', gap: '15px' }}>
                                </div>
                            ) : (
                                <div>
                                    <div style={{ fontSize: '0.8rem', display: 'flex', justifyContent: 'space-between', marginBottom: '5px' }}>
                                        <span>XP: {char.xp}</span>
                                        <span>Next: {getNextLevelXP(char.level)}</span>
                                    </div>
                                    <div style={{ width: '100%', height: '6px', background: '#1a202c', borderRadius: '3px', overflow: 'hidden' }}>
                                        <div style={{ width: `${Math.min(100, (char.xp / getNextLevelXP(char.level)) * 100)}%`, height: '100%', background: '#6366f1' }}></div>
                                    </div>
                                    <div style={{ marginTop: '10px', display: 'flex', gap: '10px' }}>
                                        <input type="number" value={xpToAdd} onChange={e => setXpToAdd(Number(e.target.value))} style={{ ...inputStyle, width: '80px' }} />
                                        <button onClick={handleAddXp} style={{ background: '#48bb78', color: 'white', border: 'none', padding: '4px 12px', borderRadius: '4px' }}>Add XP</button>
                                    </div>
                                </div>
                            )}
                        </div>

                        {/* INVENTORY */}
                        <div style={{ background: '#2d3748', padding: '15px', borderRadius: '8px' }}>
                            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '15px' }}>
                                <h4 style={{ margin: 0 }}>EQUIPMENT</h4>
                                <button onClick={openSearch} style={{ background: '#b8860b', border: 'none', color: 'white', padding: '4px 10px', borderRadius: '4px', fontSize: '0.8rem' }}>+ Library</button>
                            </div>
                            <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>
                                {char.inventory.map(item => (
                                    <div key={item.id} style={{ background: '#4a5568', padding: '10px', borderRadius: '6px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                        <span onClick={() => setViewingItem(item)} style={{ cursor: 'pointer', textDecoration: 'underline', fontSize: '0.9rem' }}>{item.name}</span>
                                        <button onClick={() => toggleItem(item.id)} style={{ background: item.equipped ? '#48bb78' : '#718096', border: 'none', color: 'white', padding: '3px 10px', borderRadius: '4px', fontSize: '0.7rem' }}>
                                            {item.equipped ? 'Equipped' : 'Equip'}
                                        </button>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>

                {/* MODALS (Search & View) */}
                {isSearching && (
                    <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.85)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 100 }}>
                        <div style={{ background: '#2d3748', padding: '20px', borderRadius: '8px', width: '400px', maxHeight: '80vh', display: 'flex', flexDirection: 'column' }}>
                            <h3>Item Library</h3>
                            <input placeholder="Search..." value={itemSearch} onChange={e => setItemSearch(e.target.value)} style={{ ...inputStyle, width: '100%', marginBottom: '15px' }} />
                            <div style={{ flex: 1, overflowY: 'auto' }}>
                                {allLibraryItems.filter(i => i.name.toLowerCase().includes(itemSearch.toLowerCase())).slice(0, 20).map((i, idx) => (
                                    <div key={`${i.name}-${idx}`} style={{ display: 'flex', justifyContent: 'space-between', padding: '8px', borderBottom: '1px solid #4a5568' }}>
                                        <span style={{ fontSize: '0.85rem' }}>{i.name}</span>
                                        <div style={{ display: 'flex', gap: '5px' }}>
                                            <button onClick={() => setViewingItem(i)} style={{ padding: '2px 6px', fontSize: '0.7rem' }}>View</button>
                                            <button onClick={() => addItemFromLibrary(i)} style={{ padding: '2px 6px', fontSize: '0.7rem', background: '#48bb78' }}>Add</button>
                                        </div>
                                    </div>
                                ))}
                            </div>
                            <button onClick={() => setIsSearching(false)} style={{ marginTop: '15px', background: '#e53e3e' }}>Close</button>
                        </div>
                    </div>
                )}

                {viewingItem && (
                    <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.9)', display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 200 }}>
                        <div style={{ background: '#1a1a1a', padding: '30px', borderRadius: '8px', width: '450px', maxHeight: '80vh', overflowY: 'auto', border: '2px solid #b8860b' }}>
                            <h2 style={{ color: '#b8860b', borderBottom: '1px solid #b8860b', paddingBottom: '10px' }}>{viewingItem.name}</h2>
                            <div style={{ margin: '20px 0', fontSize: '0.9rem', lineHeight: '1.5' }}>
                                {formatEntries(viewingItem.entries || ["No description."])}
                            </div>
                            <button onClick={() => setViewingItem(null)} style={{ width: '100%', background: '#b8860b' }}>CLOSE</button>
                        </div>
                    </div>
                )}
            </div>
            <CharacterWizard
                key={isWizardOpen ? wizardMode : 'closed'} // This forces a full reset when mode changes
                isOpen={isWizardOpen}
                mode={wizardMode}
                existingChar={wizardMode === 'levelup' ? char : null}
                onClose={() => setIsWizardOpen(false)}
                onComplete={handleWizardComplete}
            />
        </>
    );
}
